import numpy as np
import matplotlib.pyplot as plt
import matplotlib.animation as animation
from matplotlib.colors import LinearSegmentedColormap

# Model parameters

epsilon = 0.3
beta = 0.7
gam = 0.5

p = 3*((1 - gam) / gam)
q = 3 * beta / gam

def cardano(p, q):
    # Calculate the discriminant to check if we need complex numbers
    discriminant = (q**2 / 4) + (p**3 / 27)
    if discriminant >= 0:
        # Real case: standard formula works
        return np.cbrt(-q/2 + np.sqrt(discriminant)) + np.cbrt(-q/2 - np.sqrt(discriminant))
    else:
        # Complex case: use complex numbers explicitly
        # Convert to complex to force complex arithmetic
        complex_q = complex(q)
        complex_discriminant = complex(discriminant)

        # Calculate cube roots with complex numbers
        term1 = (-complex_q/2 + np.sqrt(complex_discriminant))**(1/3)
        term2 = (-complex_q/2 - np.sqrt(complex_discriminant))**(1/3)

        # The real solution is the real part of the sum
        return float(np.real(term1 + term2))

# Solve for u and v
ustar = round(cardano(p, q), 10)
vstar = round(ustar - (1/3) * ustar**3, 10)

# These are the previous simulation parametes but they are fixed for specific initial parametere
# ustar = -1.032789870
# vstar = -0.6655797400

# Simulation parameters
loops = 5000
dt = 0.01
t = 0.0
often = 100
count = 0

# Grid parameters (2D)
points = 201
L = 50
x = np.linspace(0, L, points)
y = np.linspace(0, L, points)
X, Y = np.meshgrid(x,y)
dx = L / (points - 1)

# Initial conditions (2D)
u = ustar + 5*np.exp((-(X-10)**2)/100)
v = vstar + 5*np.exp((-(Y-10)**2)/100)

# Time evolution
snapshots = []
for i in range(loops):
    # Calculate the laplacian (used for dissipating values across the grid - using central difference method
    laplacian = np.zeros_like(u)
    laplacian[1:-1, 1:-1] = (u[2:, 1:-1] + u[:-2, 1:-1] + u[1:-1, 2:] + u[1:-1, :-2] - 4*u[1:-1, 1:-1]) / (dx**2)

    # Time derivatives
    ut = (u - u**3 / 3 - v) / epsilon + laplacian
    vt = epsilon * (u + beta - gam * v)

    # Update u and v
    u += dt * ut
    v += dt * vt

    # Enforce boundary conditions so that we maintain gradient values of 0
    u[0, :] = u[1, :]
    u[-1, :] = u[-2, :]
    u[:, 0] = u[:, 1]
    u[:, -1] = u[:, -2]

    # We have to do this for both of our parameters u and v
    v[0, :] = v[1, :]
    v[-1, :] = v[-2, :]
    v[:, 0] = v[:, 1]
    v[:, -1] = v[:, -2]

    # Store snapshots for animation
    if i % often == 0:
        snapshots.append(u.copy())

# Create figure for animation - we can always save our animation later using ani.save
fig, ax = plt.subplots(figsize=(8, 8))
cax = ax.imshow(
    snapshots[0],
    extent=[x.min(), x.max(), y.min(), y.max()],
    vmin=-2,
    vmax=2,
    cmap='coolwarm',
    animated=True
)

cbar = fig.colorbar(cax, label='u')
cbar.ax.set_ylabel('u', fontsize=28)
cbar.ax.tick_params(labelsize=22)
ax.set_xlabel('x', fontsize=28)
ax.set_ylabel('y', fontsize=28)
plt.xticks(fontsize=22)
plt.yticks(fontsize=22)

def animate_frame(i):
    cax.set_array(snapshots[i])
    return [cax,]

ani = animation.FuncAnimation(
    fig,
    animate_frame,
    frames=len(snapshots),
    interval=100,
    blit=True,
    repeat=True
)

try:
    from IPython.display import HTML
    display(HTML(ani.to_jshtml()))
except ImportError:
    plt.show()

ani.save("FHN_spiral_wave.mp4", writer='ffmpeg', fps=10)
